# Copie este arquivo para .env na mesma pasta dos scripts.
# Informe sua senha somente no .env local, que está ignorado pelo Git.
# Use aspas simples ao redor da senha para preservar espaços e o caractere #.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD='COLE_SUA_SENHA_AQUI'
POSTGRES_DATABASE=transparencia_viagens

# ID público do ZIP: o script baixa automaticamente se ele não existir em
# data/viagens_2025_6meses.zip. Não é o ID da pasta do Google Drive.
DRIVE_FILE_ID=1pQjKacyHdIsyteknQbwKGM5_4hL5V4RV
